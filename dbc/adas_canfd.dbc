VERSION ""

NS_ :

BS_:

BU_: FRONT_RADAR CORNER_RADAR_FL CORNER_RADAR_FR CORNER_RADAR_RL CORNER_RADAR_RR PARK_ECU FRONT_CAMERA ADAS

CM_ "ADAS CAN FD (D9). Our own layout, modelled on production radar object lists: a status frame per scan, then one 16-byte frame per object, front radar 0x300-0x301, corner radars 0x310-0x317 (each its own status and object ids, as separate ECUs must), park sensors 0x340-0x341, front camera 0x350-0x355.";

BO_ 768 RADAR_STATUS: 8 FRONT_RADAR
 SG_ SCAN_COUNTER : 0|16@1+ (1,0) [0|65535] "" ADAS
 SG_ NUM_OBJECTS : 16|8@1+ (1,0) [0|32] "" ADAS
 SG_ SENSOR_ID : 24|4@1+ (1,0) [0|15] "" ADAS
 SG_ BLOCKED : 28|1@1+ (1,0) [0|1] "" ADAS
 SG_ COUNTER : 48|8@1+ (1,0) [0|255] "" ADAS
 SG_ CHECKSUM : 56|8@1+ (1,0) [0|255] "" ADAS

